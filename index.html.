/* ================= RUTAS ================= */

/*
Para el prototipo las rutas se crean mediante
la función createDemoRoute().

Esto permite que durante la presentación
la empresa pueda asignar una tienda y una ruta
sin necesidad de configurar un servidor.
*/


function createRoute(){

    if(currentUser.type!=="company" &&
       currentUser.type!=="admin"){

        return;
    }


    const workerId=
    parseInt(prompt(
        "ID del trabajador:\n"+
        data.workers.map(
            w=>w.id+" - "+w.name
        ).join("\n")
    ));


    if(!workerId)return;


    const storeId=
    parseInt(prompt(
        "ID de la tienda:\n"+
        data.stores.map(
            s=>s.id+" - "+s.name
        ).join("\n")
    ));


    if(!storeId)return;


    const store=
    data.stores.find(s=>s.id===storeId);


    if(!store){

        alert("Tienda no encontrada.");

        return;
    }


    const origin=
    prompt(
        "Ingrese el origen:",
        "Mercado de Bazurto"
    );


    if(!origin)return;


    const route={

        id:Date.now(),

        workerId,

        storeId,

        origin,

        destination:store.name,

        distance:"Calculada al visualizar",

        duration:"Calculada al visualizar",

        risks:1,

        rest:"Centro Comercial Olaya Plaza",

        originLat:10.399,

        originLng:-75.488,

        destinationLat:store.lat,

        destinationLng:store.lng

    };


    data.routes.push(route);

    saveData();

    refreshEverything();

    alert(
        "MercaRuta asignada correctamente.\n\n"+
        "Trabajador: "+workerId+
        "\nTienda: "+store.name
    );

}


