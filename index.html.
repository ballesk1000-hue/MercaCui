<label>Lugar</label>
<input id="trainingPlace"
placeholder="Sede MercaCui">

<button class="action-btn" onclick="createTraining()">
📚 Asignar capacitación
</button>

</div>

<div class="panel">

<h3>Capacitaciones</h3>

<div id="trainingList"></div>

</div>

</section>


<!-- ================= TRABAJADORES ================= -->

<section id="trabajadores" class="page">

<div class="page-title">
<h2>👷 Trabajadores</h2>
<p>Información de los mercaderistas registrados.</p>
</div>

<div id="workerForm" class="panel hidden">

<h3>Registrar trabajador</h3>

<label>Nombre completo</label>
<input id="workerName">

<label>Documento</label>
<input id="workerDocument">

<label>Usuario</label>
<input id="workerUsername">

<label>Empresa</label>
<input id="workerCompany">

<label>Vehículo / Moto</label>
<input id="workerVehicle">

<button class="action-btn" onclick="createWorker()">
➕ Registrar trabajador
</button>

</div>

<div class="panel">

<h3>Mercaderistas</h3>

<div id="workerList"></div>

</div>

</section>


<!-- ================= ADMINISTRACIÓN ================= -->

<section id="empresa" class="page">

<div class="page-title">
<h2>🏢 Administración</h2>
<p>Configuración básica del prototipo.</p>
</div>

<div class="panel">

<h3>Personalización de MercaCui</h3>

<label>Nombre de la aplicación</label>
<input id="customAppName">

<label>Descripción</label>
<input id="customSubtitle">

<label>Color principal</label>
<input id="customColor" type="color" value="#0b7a75">

<button class="action-btn" onclick="saveCustomization()">
💾 Guardar cambios
</button>

</div>

