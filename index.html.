</div>

<div class="panel">

<h3>Mis notificaciones</h3>

<div id="notificationList"></div>

</div>

</section>


<!-- ================= CAPACITACIONES ================= -->

<section id="capacitaciones" class="page">

<div class="page-title">
<h2>📚 MercaCap</h2>
<p>Capacitaciones asignadas a los mercaderistas.</p>
</div>

<div id="companyTrainingForm" class="panel hidden">

<h3>Asignar capacitación</h3>

<label>Trabajador</label>
<select id="trainingWorker"></select>

<label>Tema</label>
<input id="trainingTopic"
placeholder="Ejemplo: Manejo del estrés laboral">

<label>Fecha</label>
