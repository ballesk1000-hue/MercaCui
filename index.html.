/* ================= MAPA ================= */

function initializeMap(){

    if(map){

        map.invalidateSize();

        return;
    }


    map=
    L.map("map").setView(
        [10.3910,-75.4794],
        13
    );


    L.tileLayer(
        "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        {
            attribution:
            '&copy; OpenStreetMap contributors'
        }
    ).addTo(map);


    setTimeout(()=>{
        map.invalidateSize();
    },300);

}


function calculateMapRoute(route){

    if(!map)return;


    if(routeLine){

        map.removeLayer(routeLine);
        routeLine=null;

    }


    if(motorcycleMarker){

        map.removeLayer(motorcycleMarker);
        motorcycleMarker=null;

    }


    const start=[
        route.originLat,
        route.originLng
    ];

    const end=[
        route.destinationLat,
        route.destinationLng
    ];


    /*
    Para evitar depender de un servidor de rutas
    durante la demostración, se dibuja una ruta
    visual sencilla entre origen y destino.
    */


    const middleLat=
    (start[0]+end[0])/2 + 0.002;

    const middleLng=
    (start[1]+end[1])/2;


    const points=[
        start,
        [middleLat,middleLng],
        end
    ];


    routeLine=
    L.polyline(
        points,
        {
            weight:6
        }
    ).addTo(map);


    L.marker(start)
    .addTo(map)
    .bindPopup(
        "<b>📍 Inicio</b><br>"+
        escapeHTML(route.origin)
    );


    const store=
    data.stores.find(
        s=>s.id===route.storeId
    );


    L.marker(end)
    .addTo(map)
    .bindPopup(
        "<b>🏪 Destino</b><br>"+
        escapeHTML(
            store ? store.name : route.destination
        )
    );


    L.marker(
        [middleLat,middleLng]
    )
    .addTo(map)
    .bindPopup(
        "<b>⚠️ Punto de atención</b><br>"+
        "Zona registrada como riesgo."
    );


    L.circle(
        [middleLat,middleLng],
        {
            radius:150
        }
    ).addTo(map);


    map.fitBounds(
        routeLine.getBounds(),
        {padding:[30,30]}
    );


    /*
    Cálculo aproximado para la demostración.
    */

    const distanceKm=
    map.distance(start,end)/1000;


    const timeMin=
    Math.max(
        5,
        Math.round(distanceKm/0.35)
    );


    document.getElementById("routeDistance")
    .textContent=
    distanceKm.toFixed(2)+" km";


    document.getElementById("routeTime")
    .textContent=
    timeMin+" min";


    route.distance=
    distanceKm.toFixed(2)+" km";

    route.duration=
    timeMin+" min";


    saveData();

}


