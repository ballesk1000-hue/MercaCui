</div>

</section>


<!-- ================= NOTIFICACIONES ================= -->

<section id="notificaciones" class="page">

<div class="page-title">
<h2>🔔 Notificaciones</h2>
<p>Alertas y comunicaciones de MercaCui.</p>
</div>

<div id="companyNotificationForm" class="panel hidden">

<h3>Enviar notificación</h3>

<label>Trabajador</label>
<select id="notificationWorker"></select>

<label>Tipo</label>
<select id="notificationType">

<option value="MercaRuta">
🏍️ MercaRuta
