<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>MercaCui | Prototipo</title>

<link rel="stylesheet"
href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#f3f6f8;
    color:#17202a;
}

:root{
    --principal:#0b7a75;
    --secundario:#13a89e;
    --oscuro:#07544f;
    --claro:#e7f7f5;
    --blanco:#ffffff;
    --gris:#6b7280;
    --rojo:#d64545;
    --amarillo:#f0a500;
    --verde:#198754;
}

button{
    border:none;
    cursor:pointer;
}

.hidden{
    display:none!important;
}

/* LOGIN */

#loginScreen{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:20px;
    background:linear-gradient(135deg,#07544f,#13a89e);
}

.login-box{
    width:100%;
    max-width:430px;
    background:white;
    border-radius:20px;
    padding:35px;
    box-shadow:0 15px 40px rgba(0,0,0,.20);
}

.logo-login{
    text-align:center;
    margin-bottom:25px;
}

.logo-login h1{
    color:var(--principal);
    font-size:38px;
}

.logo-login p{
    color:#666;
    margin-top:6px;
}

.login-box h2{
    text-align:center;
    margin-bottom:20px;
}

input,select,textarea{
    width:100%;
    padding:12px;
    margin-top:7px;
    margin-bottom:15px;
    border:1px solid #d5dadd;
    border-radius:9px;
    font-size:15px;
}

label{
    font-weight:bold;
    font-size:14px;
}

.primary-btn{
    width:100%;
    padding:13px;
    background:var(--principal);
    color:white;
    border-radius:9px;
    font-weight:bold;
    font-size:15px;
}

.primary-btn:hover{
    background:var(--oscuro);
}

.demo-info{
    margin-top:20px;
    background:#f0f7f7;
    padding:13px;
    border-radius:10px;
    font-size:13px;
}

/* APP */

#app{
    min-height:100vh;
}

.topbar{
    background:var(--principal);
    color:white;
    padding:13px 20px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:15px;
    position:sticky;
    top:0;
    z-index:1000;
}

.topbar h1{
    font-size:25px;
}

.topbar small{
    opacity:.9;
}

.logout{
    background:white;
    color:var(--principal);
    padding:9px 13px;
    border-radius:8px;
    font-weight:bold;
}

.layout{
    display:flex;
    min-height:calc(100vh - 63px);
}

.sidebar{
    width:235px;
    background:#073f3b;
    color:white;
    padding:15px;
}

.sidebar button{
    width:100%;
    padding:12px;
    margin-bottom:8px;
    text-align:left;
    border-radius:8px;
    background:transparent;
    color:white;
}

.sidebar button:hover,
.sidebar button.active{
    background:#0b7a75;
}

.content{
    flex:1;
    padding:25px;
    max-width:1400px;
}

.page{
    display:none;
}

.page.active{
    display:block;
}

.page-title{
    margin-bottom:20px;
}

.page-title h2{
    font-size:28px;
}

.page-title p{
    color:var(--gris);
    margin-top:5px;
}

/* CARDS */

.cards{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(190px,1fr));
    gap:15px;
    margin-bottom:25px;
}

.card{
    background:white;
    padding:20px;
    border-radius:14px;
    box-shadow:0 3px 12px rgba(0,0,0,.06);
}

.card h3{
    font-size:15px;
    color:#666;
}

.card .number{
    font-size:32px;
    font-weight:bold;
    color:var(--principal);
    margin-top:8px;
}

.panel{
    background:white;
    padding:22px;
    border-radius:14px;
    box-shadow:0 3px 12px rgba(0,0,0,.06);
    margin-bottom:20px;
}

.panel h3{
    margin-bottom:15px;
}

.grid2{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}

.grid3{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
}

/* MAPA */

#map{
    height:450px;
    width:100%;
    border-radius:12px;
    margin-top:15px;
}

.route-info{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
    margin-top:15px;
}

.route-stat{
    background:var(--claro);
    padding:15px;
    border-radius:10px;
}

.route-stat strong{
    display:block;
    color:var(--principal);
    font-size:20px;
    margin-top:5px;
}

/* LISTAS */

.list-item{
    border:1px solid #e3e7e9;
    border-radius:10px;
    padding:14px;
    margin-bottom:10px;
    background:#fff;
}

.list-item strong{
    display:block;
    margin-bottom:5px;
}

.badge{
    display:inline-block;
    padding:5px 8px;
    border-radius:20px;
    font-size:12px;
    font-weight:bold;
    background:#e8f5f3;
    color:var(--principal);
}

.badge-red{
    background:#ffe9e9;
    color:var(--rojo);
}

.badge-yellow{
    background:#fff4d6;
    color:#9a6700;
}

.badge-green{
    background:#e3f7eb;
    color:#14733f;
}

.action-btn{
    background:var(--principal);
    color:white;
    padding:9px 12px;
    border-radius:7px;
    margin-top:5px;
}

.delete-btn{
    background:#ffe5e5;
    color:var(--rojo);
    padding:8px 10px;
    border-radius:7px;
}

.notification{
    border-left:5px solid var(--principal);
    background:#f5fbfa;
    padding:15px;
    margin-bottom:10px;
    border-radius:8px;
}

.notification strong{
    color:var(--principal);
}

.success{
    background:#e5f8ed;
    color:#126c3b;
    padding:12px;
    border-radius:8px;
    margin-bottom:15px;
}

.warning{
    background:#fff4d8;
    color:#805f00;
    padding:12px;
    border-radius:8px;
    margin-bottom:15px;
}

.danger{
    background:#ffe8e8;
    color:#8d2525;
    padding:12px;
    border-radius:8px;
    margin-bottom:15px;
}

/* TIENDAS */

.store-card{
    border:1px solid #dde5e5;
    padding:16px;
    border-radius:12px;
    margin-bottom:10px;
}

.store-icon{
    font-size:28px;
    float:left;
    margin-right:10px;
}

/* MOBILE */

@media(max-width:800px){

    .layout{
        display:block;
    }

    .sidebar{
        width:100%;
        display:flex;
        overflow-x:auto;
        gap:6px;
    }

    .sidebar button{
        min-width:150px;
        margin-bottom:0;
    }

    .content{
        padding:15px;
    }

    .grid2,
    .grid3{
        grid-template-columns:1fr;
    }

    .route-info{
        grid-template-columns:1fr 1fr;
    }

    .topbar h1{
        font-size:20px;
    }
}
</style>
</head>

<body>

<!-- ================= LOGIN ================= -->

<section id="loginScreen">

<div class="login-box">

<div class="logo-login">
    <h1>MercaCui</h1>
    <p>Cuidado integral del mercaderista</p>
</div>

<h2>Ingreso al sistema</h2>

<label>Usuario</label>
<input id="loginUser" placeholder="Ingrese su usuario">

<label>Contraseña</label>
<input id="loginPass" type="password" placeholder="Ingrese su contraseña">

<button class="primary-btn" onclick="login()">
    Ingresar
</button>

<div id="loginError" class="danger hidden">
    Usuario o contraseña incorrectos.
</div>

<div class="demo-info">
    <strong>Usuarios de demostración</strong><br><br>

    👷 Trabajador:<br>
    usuario: <b>trabajador</b><br>
    contraseña: <b>MercaCui2026*</b><br><br>

    🏢 Empresa:<br>
    usuario: <b>empresa</b><br>
    contraseña: <b>MercaCui2026*</b>
</div>

</div>
</section>


<!-- ================= APP ================= -->

<div id="app" class="hidden">

<header class="topbar">

<div>
    <h1 id="appName">MercaCui</h1>
    <small id="appSubtitle">
        Cuidado integral del mercaderista
    </small>
</div>

<div>
    <span id="currentUserName"></span>
    <button class="logout" onclick="logout()">
        Salir
    </button>
</div>

</header>


<div class="layout">

<!-- SIDEBAR -->

<aside class="sidebar">

<button onclick="showPage('inicio')" id="btnInicio">
    🏠 Inicio
</button>

<button onclick="showPage('ruta')" id="btnRuta">
    🏍️ MercaRuta
</button>

<button onclick="showPage('tiendas')" id="btnTiendas">
    🏪 Tiendas
</button>

<button onclick="showPage('notificaciones')" id="btnNotificaciones">
    🔔 Notificaciones
</button>

<button onclick="showPage('capacitaciones')" id="btnCapacitaciones">
    📚 Capacitaciones
</button>

<button onclick="showPage('trabajadores')" id="btnTrabajadores">
    👷 Trabajadores
</button>

<button onclick="showPage('empresa')" id="btnEmpresa">
    🏢 Administración
</button>

</aside>


<main class="content">

<!-- ================= INICIO ================= -->

<section id="inicio" class="page active">

<div class="page-title">
<h2>Bienvenido a MercaCui</h2>
<p id="welcomeText"></p>
</div>

<div class="cards">

<div class="card">
<h3>Trabajadores</h3>
<div class="number" id="countWorkers">0</div>
</div>

<div class="card">
<h3>Tiendas</h3>
<div class="number" id="countStores">0</div>
</div>

<div class="card">
<h3>Rutas</h3>
<div class="number" id="countRoutes">0</div>
</div>

<div class="card">
<h3>Notificaciones</h3>
<div class="number" id="countNotifications">0</div>
</div>

</div>

<div class="panel">

<h3>¿Qué es MercaCui?</h3>

<p>
MercaCui es una propuesta de apoyo en Seguridad y Salud en el Trabajo
dirigida a mercaderistas, integrando la gestión de rutas, tiendas,
descansos, capacitaciones y notificaciones de seguridad en una sola
