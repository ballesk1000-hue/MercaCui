</div>

<div class="panel">

<h3>Mi ruta asignada</h3>

<div id="workerRouteInfo"></div>

<div class="route-info">

<div class="route-stat">
Distancia
<strong id="routeDistance">--</strong>
</div>

<div class="route-stat">
Tiempo estimado
<strong id="routeTime">--</strong>
</div>

<div class="route-stat">
Riesgos
<strong id="routeRisks">0</strong>
</div>

<div class="route-stat">
Descanso
<strong id="routeRest">--</strong>
</div>

</div>

<div id="map"></div>

</div>

</section>


<!-- ================= TIENDAS ================= -->

<section id="tiendas" class="page">

<div class="page-title">
<h2>🏪 Tiendas</h2>
<p>Destinos asignados a los mercaderistas.</p>
</div>

<div id="companyStoreForm" class="panel hidden">

<h3>Registrar nueva tienda</h3>

<label>Nombre de la tienda</label>
<input id="storeName" placeholder="Ejemplo: Tienda La Playita">

<label>Dirección</label>
<input id="storeAddress" placeholder="Ejemplo: Sector Progreso">

<label>Responsable de la tienda</label>
<input id="storeContact" placeholder="Nombre del responsable">

<label>Descripción</label>
<textarea id="storeDescription"
placeholder="Información adicional de la tienda"></textarea>

