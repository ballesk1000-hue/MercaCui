</div>

</section>

</main>
</div>
</div>


<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>

/* =========================================================
   MERCACUI - PROTOTIPO DE MUESTRA PRODUCTIVA
   ========================================================= */


/* ================= DATOS ================= */

const defaultData = {

    workers:[
        {
            id:1,
            name:"Trabajador Demo",
            document:"1000000000",
            username:"trabajador",
            company:"Empresa MercaCui",
            vehicle:"Moto"
        }
    ],

    stores:[
        {
            id:1,
            name:"Tienda La Playita",
            address:"Sector Progreso, Cartagena",
            contact:"Responsable de tienda",
            description:"Punto de venta asignado al mercaderista.",
            lat:10.399,
            lng:-75.494
        },
        {
            id:2,
            name:"Tienda Hayan",
            address:"Cartagena de Indias",
            contact:"Responsable de tienda",
            description:"Punto de venta demostrativo.",
            lat:10.401,
            lng:-75.487
        }
    ],

    routes:[
        {
            id:1,
            workerId:1,
            storeId:1,
            origin:"Mercado de Bazurto",
            destination:"Tienda La Playita",
            distance:"",
            duration:"",
            risks:1,
            rest:"Centro Comercial Olaya Plaza",
            originLat:10.399,
            originLng:-75.488,
            destinationLat:10.399,
            destinationLng:-75.494
        }
    ],

    notifications:[
        {
            id:1,
            workerId:1,
            type:"MercaRuta",
            message:"Recuerda verificar tu Ruta Segura antes de iniciar el recorrido.",
            date:new Date().toLocaleString()
        },
        {
            id:2,
            workerId:1,
            type:"MercaDes",
            message:"Es hora de realizar tu pausa activa y descanso reglamentario.",
            date:new Date().toLocaleString()
        }
    ],

    trainings:[
        {
            id:1,
            workerId:1,
            topic:"Manejo del estrés laboral en las vías y carreteras",
            date:"2026-09-25",
            place:"Sede MercaCui - Barrio Amberes"
        }
    ],

    customization:{
        name:"MercaCui",
        subtitle:"Cuidado integral del mercaderista",
        color:"#0b7a75"
    }

};


let data =
JSON.parse(localStorage.getItem("mercacui_data")) ||
JSON.parse(JSON.stringify(defaultData));


let currentUser = null;
let map = null;
let routeLine = null;
let motorcycleMarker = null;
let mapMarkers = [];


/* ================= GUARDAR ================= */

function saveData(){

    localStorage.setItem(
        "mercacui_data",
        JSON.stringify(data)
    );

}


/* ================= LOGIN ================= */

function login(){

    const user =
    document.getElementById("loginUser").value.trim();

    const pass =
    document.getElementById("loginPass").value;

    document.getElementById("loginError")
    .classList.add("hidden");


    if(
        user === "empresa" &&
        pass === "MercaCui2026*"
    ){

        currentUser={
            type:"company",
            username:"empresa",
            name:"Administrativo / Empresa"
        };

        startApp();
        return;
    }


    if(
        user === "trabajador" &&
        pass === "MercaCui2026*"
    ){

        currentUser={
            type:"worker",
            username:"trabajador",
            name:"Trabajador Demo",
            workerId:1
        };

        startApp();
        return;
    }


    if(
        user === "admin" &&
        pass === "MercaCuiAdmin2026*"
    ){

        currentUser={
            type:"admin",
            username:"admin",
            name:"Administrador MercaCui"
        };

        startApp();
        return;
    }


    document.getElementById("loginError")
    .classList.remove("hidden");

}


function logout(){

    currentUser=null;

    document.getElementById("app")
    .classList.add("hidden");

    document.getElementById("loginScreen")
    .classList.remove("hidden");

}


/* ================= INICIAR APP ================= */

function startApp(){

    document.getElementById("loginScreen")
    .classList.add("hidden");

    document.getElementById("app")
    .classList.remove("hidden");

    document.getElementById("currentUserName")
    .textContent=currentUser.name;

    configurePermissions();

    applyCustomization();

    refreshEverything();

    showPage("inicio");

}


/* ================= PERMISOS ================= */

function configurePermissions(){

    const isWorker =
    currentUser.type === "worker";

    const isCompany =
    currentUser.type === "company";

    const isAdmin =
    currentUser.type === "admin";


    document.getElementById("btnTrabajadores")
    .classList.toggle("hidden",!isCompany && !isAdmin);

    document.getElementById("btnEmpresa")
    .classList.toggle("hidden",!isCompany && !isAdmin);


    document.getElementById("companyStoreForm")
    .classList.toggle("hidden",!isCompany && !isAdmin);

    document.getElementById("companyNotificationForm")
    .classList.toggle("hidden",!isCompany && !isAdmin);

    document.getElementById("companyTrainingForm")
    .classList.toggle("hidden",!isCompany && !isAdmin);

    document.getElementById("workerForm")
    .classList.toggle("hidden",!isCompany && !isAdmin);

}


/* ================= NAVEGACIÓN ================= */

function showPage(page){

    document
    .querySelectorAll(".page")
    .forEach(p=>p.classList.remove("active"));

    const selected =
    document.getElementById(page);

    if(selected){
        selected.classList.add("active");
    }


    document
    .querySelectorAll(".sidebar button")
    .forEach(b=>b.classList.remove("active"));


    const btn =
    document.getElementById("btn"+capitalize(page));

    if(btn){
        btn.classList.add("active");
    }


    if(page==="ruta"){
        setTimeout(()=>{
            initializeMap();
            loadWorkerRoute();
        },200);
    }

}


function capitalize(text){

    return text.charAt(0).toUpperCase()+text.slice(1);

}


/* ================= REFRESCAR TODO ================= */

function refreshEverything(){

    updateDashboard();

    renderWorkers();

    renderStores();

    renderNotifications();

    renderTrainings();

    populateWorkerSelects();

    loadWorkerRoute();

    renderCompanyRoutes();

}


/* ================= DASHBOARD ================= */

function updateDashboard(){

    document.getElementById("countWorkers")
    .textContent=data.workers.length;

    document.getElementById("countStores")
    .textContent=data.stores.length;

    document.getElementById("countRoutes")
